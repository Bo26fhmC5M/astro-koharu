{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "cms", "src/features/live2d/vendor"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@assets/*": ["assets/*"],
      "@components/*": ["components/*"],
      "@content/*": ["content/*"],
      "@layouts/*": ["layouts/*"],
      "@pages/*": ["pages/*"],
      "@styles/*": ["styles/*"],
      "@lib/*": ["lib/*"],
      "@constants/*": ["constants/*"],
      "@hooks/*": ["hooks/*"],
      "@store/*": ["store/*"],
      "@scripts/*": ["scripts/*"],
      "@types/*": ["types/*"],
      "@cubism-framework/*": ["features/live2d/vendor/CubismSdkForWeb-5-r.4/Framework/dist/*"]
    }
  }
}
